<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net481;net10.0;net11.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Reinforced.Typings.Cli</RootNamespace>
    <AssemblyName>rtcli</AssemblyName>
    <AssemblyTitle>rtcli</AssemblyTitle>
    <StartupObject>Reinforced.Typings.Cli.Bootstrapper</StartupObject>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- The task runs "dotnet rtcli.dll"; a per-OS native launcher is never used. -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Reinforced.Typings\Sign.cs" Link="Sign.cs" Condition="'$(RtSign)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Reinforced.Typings\Reinforced.Typings.csproj" />
  </ItemGroup>

  <!-- Consumers' assemblies may reference ASP.NET Core types, which must load from the shared framework. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net481'">
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
</Project>
