<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFrameworks>net481;net10.0;net11.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Reinforced.Typings.Cli</RootNamespace>
    <AssemblyName>rtcli</AssemblyName>
    <AssemblyTitle>rtcli</AssemblyTitle>
    <StartupObject>Reinforced.Typings.Cli.Bootstrapper</StartupObject>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Reinforced.Typings\Sign.cs" Link="Sign.cs" Condition="'$(RtSign)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Reinforced.Typings\Reinforced.Typings.csproj" />
  </ItemGroup>
</Project>
