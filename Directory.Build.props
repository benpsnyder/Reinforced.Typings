<Project>
  <PropertyGroup>
    <Version>3.1.0</Version>
    <Company>Reinforced Software Construction OSS</Company>
    <Copyright>Pavel B. Novikov 2019</Copyright>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <DebugType>portable</DebugType>
    <!-- netstandard2.0/net481 assets are still built; do not nag about them. -->
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
  </PropertyGroup>

  <!--
    Strong naming. Sign.cs carries [assembly: AssemblyKeyFile("Reinforced.snk")], which the compiler
    resolves against the project directory, exactly as in 2.0.3. The private key is not in the
    repository (.gitignore excludes it), so Sign.cs is compiled only when the key file is present.
    Without it the assemblies build unsigned.
  -->
  <PropertyGroup>
    <RtSign Condition="Exists('$(MSBuildProjectDirectory)/Reinforced.snk')">true</RtSign>
  </PropertyGroup>
</Project>
