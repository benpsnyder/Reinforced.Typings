<Project Sdk="Microsoft.NET.Sdk">
  <!--
    End-to-end consumer of the Reinforced.Typings.vNext package.
    The e2e runner (e2e/run.cs) copies this folder to a scratch directory and builds it once per
    target framework against a local package feed:
      -p:RtE2EFramework=<tfm> -p:RtPackageVersion=<version>
  -->
  <PropertyGroup>
    <TargetFramework>$(RtE2EFramework)</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <RootNamespace>E2E.Consumer</RootNamespace>
    <AssemblyName>E2E.Consumer</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!--
    Upstream #284/#206: -p:RtE2ESystemTextJson=<version> references a System.Text.Json package
    whose assembly version is newer than the runtime's (for example 11.0.0 on net10.0).
  -->
  <ItemGroup Condition="'$(RtE2ESystemTextJson)' != ''">
    <PackageReference Include="System.Text.Json" Version="$(RtE2ESystemTextJson)" />
  </ItemGroup>

  <!--
    -p:RtE2EVariant=modern compiles ModernModels.cs and the matching fluent configuration, and
    also writes the Effect Schema module (golden files consumer.modern.ts / consumer.modern.schema.ts).
  -->
  <PropertyGroup Condition="'$(RtE2EVariant)' == 'modern'">
    <DefineConstants>$(DefineConstants);RT_E2E_MODERN</DefineConstants>
    <RtEffectSchemaFile>$(MSBuildProjectDirectory)/generated/consumer.schema.ts</RtEffectSchemaFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Reinforced.Typings.vNext" Version="$(RtPackageVersion)" />
  </ItemGroup>

  <!--
    Records what the RtCli task passes to rtcli (source assembly, XML doc file, configuration
    method, references) so e2e/measure.cs can time the tool in isolation.
  -->
  <Target Name="RtE2ERecordInputs" AfterTargets="CoreCompile">
    <ItemGroup>
      <_RtE2EInput Include="@(IntermediateAssembly->'source=%(FullPath)')" />
      <_RtE2EInput Include="doc=$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/$(DocumentationFile)'))" />
      <_RtE2EInput Include="method=$(RtConfigurationMethod)" />
      <_RtE2EInput Include="@(ReferencePath->'ref=%(FullPath)')" />
    </ItemGroup>
    <WriteLinesToFile File="$(ProjectDir)generated/rt-inputs.txt" Lines="@(_RtE2EInput)" Overwrite="true" />
  </Target>
</Project>
