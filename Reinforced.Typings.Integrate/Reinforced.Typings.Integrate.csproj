<Project Sdk="Microsoft.NET.Sdk">
  <!--
    MSBuild task. net472 is what Visual Studio's MSBuild.exe loads; netstandard2.0 loads in every
    dotnet SDK. The task only launches rtcli, so newer frameworks gain nothing.
  -->
  <PropertyGroup>
    <TargetFrameworks>net472;netstandard2.0</TargetFrameworks>
    <RootNamespace>Reinforced.Typings.Integrate</RootNamespace>
    <AssemblyName>Reinforced.Typings.Integrate</AssemblyName>
    <AssemblyTitle>Reinforced.Typings.Integrate</AssemblyTitle>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Reinforced.Typings.Cli\ConsoleHelpAttribute.cs" Link="ConsoleHelpAttribute.cs" />
    <Compile Include="..\Reinforced.Typings.Cli\ExporterConsoleParameters.cs" Link="ExporterConsoleParameters.cs" />
    <Compile Include="..\Reinforced.Typings\Sign.cs" Link="Sign.cs" Condition="'$(RtSign)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Framework" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
